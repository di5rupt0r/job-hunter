[Unit]
Description=Job Hunter Python Orchestrator
After=network.target

[Service]
User=copilot
WorkingDirectory=/home/copilot/job-hunter
EnvironmentFile=/home/copilot/job-hunter/.env
ExecStart=/home/copilot/job-hunter/.venv/bin/python orchestrator.py
Restart=on-failure
RestartSec=30

[Install]
WantedBy=multi-user.target
